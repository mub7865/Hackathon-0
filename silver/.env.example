# Silver Tier - Environment Variables
# Copy this file to .env and fill in your actual values

# Claude Code Router Configuration
ANTHROPIC_BASE_URL=http://127.0.0.1:3456
ANTHROPIC_AUTH_TOKEN=test
NO_PROXY=127.0.0.1
API_TIMEOUT_MS=600000

# Gmail MCP Configuration
GMAIL_CREDENTIALS_PATH=/path/to/silver/.credentials/gmail-credentials.json
GMAIL_TOKEN_PATH=/path/to/silver/.credentials/gmail-token.json

# WhatsApp Configuration (if using WhatsApp Business API)
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER=your_phone_number_here

# Browser MCP Configuration
HEADLESS=true

# Optional: Twilio (for WhatsApp via Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
